{
  "selection_split": "val",
  "selection_kind": "one-step a priori only",
  "criterion": "existing metrics.evaluate selection_score, after Wang correction",
  "score": "mean(log1p(min(abs(Ypred-Ytrue)/max(Ytrue,1e-8),1e12))) + 10*major_Y_RMSE + 10*mass_sum_MAE + 100*invalid_row_fraction",
  "major_species_threshold": 0.001,
  "ties": "ascending seed",
  "ranking_uses": "all 18 validation trajectories, every one of 5000 adjacent fixed-dt pairs",
  "transformed_mse_used_for_selection": false,
  "posteriori_used_for_selection": false,
  "test_used_for_selection": false,
  "retraining": false,
  "dt": 2e-06,
  "horizon": 0.01,
  "physics_backend": "wang_boxcox",
  "no_other_candidate_fallback": true,
  "max_execution_seconds": 1800,
  "batch_size": 1024
}